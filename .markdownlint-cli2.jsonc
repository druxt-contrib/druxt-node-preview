{
  // MD013 (line length) is off: prose reflows, and a hard wrap in Markdown
  // shows up as a diff on every edit to the paragraph rather than the sentence.
  // MD033 (inline HTML) is off: the README banner and badges need it.
  // MD024 is scoped to siblings so a changelog can repeat "Fixed" per release.
  "config": {
    "default": true,
    "MD013": false,
    "MD024": { "siblings_only": true },
    "MD033": false,
    "MD041": false
  },
  "ignores": [
    "node_modules/**",
    "**/node_modules/**",
    "dist/**",
    "coverage/**",
    "example/**/node_modules/**",
    "example/drupal/vendor/**",
    "example/drupal/web/**",
    "example/nuxt/dist/**",
    "example/nuxt/.nuxt/**",
    "test/e2e/reports/**",
    ".vale/**",
    "CHANGELOG.md",
    ".changeset/**"
  ]
}
