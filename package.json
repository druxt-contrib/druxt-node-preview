{
  "name": "@druxt-contrib/node-preview",
  "version": "0.0.0",
  "description": "Renders Drupal node previews in a Druxt frontend, fed by JSON:API Node Preview and Consumer Node Preview.",
  "keywords": [
    "decoupled",
    "drupal",
    "druxt",
    "jsonapi",
    "json:api",
    "module",
    "node preview",
    "nuxt",
    "preview"
  ],
  "homepage": "https://github.com/druxt-contrib/druxt-node-preview#readme",
  "bugs": "https://github.com/druxt-contrib/druxt-node-preview/issues",
  "repository": "github:druxt-contrib/druxt-node-preview",
  "license": "MIT",
  "exports": {
    ".": {
      "require": "./dist/index.ssr.js",
      "import": "./dist/index.ssr.js"
    },
    "./package.json": "./package.json"
  },
  "main": "dist/index.ssr.js",
  "module": "dist/index.esm.js",
  "files": [
    "dist",
    "templates",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "siroc build",
    "build:watch": "siroc build --watch",
    "changeset": "changeset",
    "hooks:install": "git config core.hooksPath .githooks",
    "postinstall": "node scripts/postinstall.mjs",
    "lint": "npm run lint:js && npm run lint:format && npm run lint:md && npm run lint:cspell && npm run lint:private && npm run lint:attribution && npm run lint:knip",
    "lint:attribution": "bash .gitlab/scripts/check-attribution.sh",
    "lint:audit": "npm audit --omit=dev --audit-level=high",
    "lint:commit": "commitlint",
    "lint:cspell": "cspell lint --no-progress --no-must-find-files --gitignore --dot \"**/*.{js,mjs,vue,json,jsonc,md,yml,yaml}\"",
    "lint:format": "prettier --check \"**/*.{js,mjs,vue,json,jsonc,md,yml,yaml}\"",
    "lint:format:fix": "prettier --write \"**/*.{js,mjs,vue,json,jsonc,md,yml,yaml}\"",
    "lint:js": "eslint --ext .js,.mjs,.vue src templates test scripts",
    "lint:knip": "knip --include dependencies,unlisted --no-config-hints",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "lint:private": "node scripts/lint-private-refs.mjs",
    "lint:prose": "PROSE_LINT_GLOB='!{.changeset,example/drupal}/**' bash .gitlab/scripts/lint-prose.sh --all",
    "lint:prose:install": "bash .gitlab/scripts/install-vale.sh .vale/bin .vale/styles",
    "prepack": "npm run build",
    "test": "jest",
    "test:e2e": "playwright test",
    "test:e2e:stack": "test/e2e/run.sh",
    "test:watch": "jest --watch"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@changesets/cli": "2.25.2",
    "@commitlint/cli": "17.8.1",
    "@commitlint/config-conventional": "17.8.1",
    "@playwright/test": "^1.49.0",
    "babel-core": "7.0.0-bridge.0",
    "cspell": "7.3.9",
    "druxt": "0.25.0",
    "druxt-entity": "0.29.0",
    "esbuild-jest": "0.5.0",
    "eslint": "8.28.0",
    "eslint-config-prettier": "8.10.0",
    "eslint-plugin-nuxt": "3.2.0",
    "eslint-plugin-vue": "8.7.1",
    "jest": "27.5.1",
    "jest-environment-jsdom": "27.5.1",
    "jest-junit": "^15.0.0",
    "knip": "2.43.0",
    "markdownlint-cli2": "0.10.0",
    "prettier": "3.3.3",
    "siroc": "0.16.0",
    "vue": "2.7.14",
    "vue-jest": "3.0.7",
    "vue-template-compiler": "2.7.14"
  },
  "peerDependencies": {
    "druxt": ">=0.25.0 <1",
    "druxt-entity": ">=0.29.0 <1",
    "vue": "^2.7.14"
  },
  "packageManager": "npm@8.19.4",
  "engines": {
    "node": ">=16.20.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "jest-junit": {
    "outputDirectory": "reports/junit",
    "outputName": "junit.xml"
  }
}
