{
  "name": "@druxt-contrib/node-preview",
  "version": "0.0.0",
  "description": "Renders Drupal node previews in a Druxt frontend, fed by JSON:API Node Preview and Consumer Node Preview.",
  "keywords": [
    "decoupled",
    "drupal",
    "druxt",
    "jsonapi",
    "json:api",
    "module",
    "node preview",
    "nuxt",
    "preview"
  ],
  "homepage": "https://github.com/druxt-contrib/druxt-node-preview#readme",
  "bugs": "https://github.com/druxt-contrib/druxt-node-preview/issues",
  "repository": "github:druxt-contrib/druxt-node-preview",
  "license": "MIT",
  "exports": {
    ".": {
      "require": "./dist/index.ssr.js",
      "import": "./dist/index.ssr.js"
    },
    "./package.json": "./package.json"
  },
  "main": "dist/index.ssr.js",
  "module": "dist/index.esm.js",
  "files": [
    "dist",
    "templates",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "siroc build",
    "build:watch": "siroc build --watch",
    "changeset": "changeset",
    "lint": "eslint --ext .js,.vue src templates test",
    "prepack": "npm run build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "test:e2e:stack": "test/e2e/run.sh"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@changesets/cli": "2.25.2",
    "@playwright/test": "^1.49.0",
    "@vue/test-utils": "1.3.3",
    "babel-core": "7.0.0-bridge.0",
    "druxt": "^0.21.0",
    "esbuild-jest": "0.5.0",
    "eslint": "8.28.0",
    "eslint-plugin-nuxt": "3.2.0",
    "jest": "27.5.1",
    "jest-junit": "^15.0.0",
    "siroc": "0.16.0",
    "vue": "2.7.14",
    "vue-jest": "3.0.7",
    "vue-template-compiler": "2.7.14"
  },
  "peerDependencies": {
    "druxt": "^0.21.0"
  },
  "packageManager": "npm@8.19.4",
  "engines": {
    "node": ">=16.20.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "jest-junit": {
    "outputName": "junit.xml"
  }
}
